      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: rgba(10, 14, 26, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 0 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-heading);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .logo:hover { text-decoration: none; color: var(--color-heading); }
  .logo-accent { color: var(--color-accent); }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-nav a {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
    text-decoration: none;
  }
  .header-nav a:hover { color: var(--color-text); }

  .header-github {
    color: var(--color-muted) !important;
    display: flex;
    align-items: center;
  }
  .header-github:hover { color: var(--color-accent) !important; }
</style>
