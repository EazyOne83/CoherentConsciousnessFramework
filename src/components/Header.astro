<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="14" cy="14" r="13" stroke="#38bdf8" stroke-width="1.5"/>
        <circle cx="14" cy="14" r="7" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 2"/>
        <circle cx="14" cy="14" r="2.5" fill="#38bdf8"/>
      </svg>
      <span class="logo-text">Coherent Systems Research <span class="logo-accent">Institute</span></span>
    </a>

    <nav class="header-nav" aria-label="Site navigation">
      <a href="/docs/foundations/introduction">Foundations</a>
      <a href="/docs/system-dynamics/overview">System Dynamics</a>
      <a href="/docs/simulation/overview">Simulation</a>
      <a href="/docs/testability/overview">Testability</a>
      <a href="/docs/applications/overview">Applications</a>
      <a href="/docs/references/overview">References</a>
      <a href="/docs/appendices/overview">Appendices</a>
      <a href="https://github.com/EazyOne83/coherentconsciousnessframework" target="_blank" rel="noopener noreferrer" class="header-github" aria-label="GitHub">
